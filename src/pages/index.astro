---
import Layout from '../layouts/Layout.astro';
import PillButton from '../components/PillButton.astro';
import ChromeSparkle from '../components/ChromeSparkle.astro';
import HudBadge from '../components/HudBadge.astro';
---

<Layout title="FEKDESIGN — Felix Koesgaard | Creative Developer">
  <!-- Boot Sequence Screen (No Glow) -->
  <div
    id="boot-sequence"
    class="fixed inset-0 z-[10000] bg-[#F8FAFC] flex flex-col items-center justify-center pointer-events-auto"
  >
    <div class="overflow-hidden mb-6 text-center">
      <h1 class="font-anton text-[#1C1C1C] tracking-tighter text-5xl sm:text-7xl lg:text-8xl leading-none">
        WAKING UP
      </h1>
    </div>

    <div class="w-64 sm:w-80 h-1 bg-slate-200 relative overflow-hidden rounded-full">
      <div id="boot-progress" class="absolute top-0 left-0 h-full bg-[#3186FF] w-0"></div>
    </div>
    <p id="boot-log" class="font-mono text-slate-500 mt-4 text-xs uppercase tracking-widest">
      Gathering pixels...
    </p>
  </div>

  <!-- Main Fixed Navigation Bar (Starts transparent on hero, frosted on scroll) -->
  <header
    id="navbar"
    class="fixed top-0 w-full z-50 px-6 md:px-12 py-5 flex justify-between items-center nav-transparent"
  >
    <div class="flex items-center gap-3">
      <ChromeSparkle size={20} />
      <a href="#" class="text-2xl md:text-3xl font-anton uppercase tracking-tight text-[#1C1C1C] hover:text-[#3186FF] transition-colors">
        FEKDESIGN
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-8 text-xs uppercase font-mono tracking-wider text-slate-600">
      <a href="#about" class="hover:text-[#1C1C1C] transition-colors">01. About</a>
      <a href="#projects" class="hover:text-[#1C1C1C] transition-colors">02. Work</a>
      <a href="#logs" class="hover:text-[#1C1C1C] transition-colors">03. Journal</a>
      <a href="#contact" class="hover:text-[#1C1C1C] transition-colors">04. Contact</a>
    </nav>

    <div class="flex items-center gap-4">
      <div class="hidden lg:block text-right font-mono text-[11px] text-slate-500">
        <p class="uppercase tracking-widest text-[9px] text-slate-400">Based in</p>
        <p class="text-[#1C1C1C] font-semibold">Copenhagen, DK</p>
      </div>
      <HudBadge text="ONLINE" statusDot={true} statusColor="#3186FF" />
      <PillButton href="#contact" variant="primary" size="sm">
        Connect
      </PillButton>
    </div>
  </header>

  <main class="relative z-10">
    <!-- Parallax Hero Composite -->
    <section class="hero-container">
      <div class="layer-text layer-back" id="parallax-text-back">
        <span class="font-vision text-solid" id="hero-title-back">WELCOME</span>
      </div>

      <img
        src="/hero-object.png"
        alt="Main Visual Component"
        class="hero-object-layer"
        id="hero-model"
        style="clip-path: inset(100% 0 0 0);"
      />

      <div class="layer-text layer-front" id="parallax-text-front">
        <span class="font-vision text-outline" id="hero-title-front">WELCOME</span>
      </div>

      <!-- Bottom Hero HUD Bar -->
      <div class="absolute bottom-0 w-full z-40 px-6 md:px-12 pb-10 pt-24 bg-gradient-to-t from-[#F8FAFC] via-[#F8FAFC]/85 to-transparent pointer-events-none">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pointer-events-auto">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-[#3186FF] mb-2 block font-semibold">
              // Creative Developer & Architect
            </span>
            <h1 class="text-4xl sm:text-6xl font-anton uppercase tracking-tight text-[#1C1C1C] leading-none">
              Felix Koesgaard
            </h1>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <p class="font-mono text-xs text-slate-600 max-w-xs leading-relaxed uppercase">
              Crafting digital environments where technology meets aesthetics.
            </p>
            <div class="flex gap-3">
              <PillButton href="#projects" variant="primary" size="md">
                View Works
              </PillButton>
              <PillButton href="#about" variant="secondary" size="md">
                Philosophy
              </PillButton>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 01: About (Form & Flow) -->
    <section id="about" class="py-24 md:py-32 border-b border-black/[0.08] bg-[#F8FAFC] relative">
      <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div class="lg:col-span-5 space-y-4 reveal-on-scroll">
            <div class="flex items-center gap-2">
              <ChromeSparkle size={18} />
              <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">01 // PHILOSOPHY</span>
            </div>
            <h2 class="section-title">
              FORM &<br />
              <span class="text-[#3186FF]">FLOW.</span>
            </h2>
          </div>

          <div class="lg:col-span-7 space-y-6 text-base sm:text-lg leading-relaxed font-mono text-pretty reveal-on-scroll reveal-delay-1">
            <p class="text-[#1C1C1C] font-semibold text-lg sm:text-xl">
              Code is just another medium. A well written function should translate into a beautifully felt interface.
            </p>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              My background is in Multimediadesign, my focus is on the human experience. I build web environments that are mindful, tactile, and inherently creative. Less about forcing engagement, more about inviting exploration.
            </p>

            <div class="pt-6">
              <span class="text-xs font-mono uppercase tracking-widest text-slate-400 block mb-4">Core Capabilities</span>
              <div class="flex flex-wrap gap-3" id="skill-container">
                <span class="skill-pill">Frontend Architecture</span>
                <span class="skill-pill">UX/UI Design</span>
                <span class="skill-pill">Astro & React Islands</span>
                <span class="skill-pill">GSAP Choreography</span>
                <span class="skill-pill">Creative Coding</span>
                <span class="skill-pill">TypeScript</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Visual Blueprint Card -->
        <div class="glass-panel p-3 rounded-3xl overflow-hidden relative group reveal-on-scroll reveal-delay-2">
          <div class="w-full h-[320px] sm:h-[420px] rounded-2xl overflow-hidden relative">
            <img
              src="/ferris-wheel-splash.JPG"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              alt="Creative Architecture Blueprint"
            />
            <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between text-xs font-mono text-[#1C1C1C] bg-white/85 backdrop-blur-md px-4 py-3 rounded-xl border border-black/[0.08] shadow-sm">
              <span class="font-semibold">PHOTO ARCHIVE // RIGID GEOMETRY</span>
              <span class="text-[#3186FF] font-bold">COPENHAGEN</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 02: Selected Works (12-Col Responsive Bento Grid) -->
    <section id="projects" class="py-24 md:py-32 border-b border-black/[0.08] bg-[#F8FAFC]">
      <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-16">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6 reveal-on-scroll">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <ChromeSparkle size={18} />
              <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">02 // SELECTED WORKS</span>
            </div>
            <h2 class="section-title mb-0">
              SELECTED<br />WORKS
            </h2>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <PillButton href="https://github.com/fek-design" variant="secondary" size="md">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              GitHub Profile
            </PillButton>
            <p class="font-mono text-xs uppercase text-slate-600 max-w-xs pl-4 border-l border-black/10">
              Digital environments built with intent. A collection of recent interactive deployments.
            </p>
          </div>
        </div>

        <!-- 12-Column Asymmetric Bento Grid (Strict 8pt Rhythm: 384px height) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Card 1: DESO (7 cols) -->
          <a
            href="https://deso.dk"
            target="_blank"
            rel="noopener noreferrer"
            class="project-card col-span-1 lg:col-span-7 h-[384px] group reveal-on-scroll"
          >
            <div class="absolute inset-0 z-0">
              <img
                src="/deso.webp"
                alt="DESO Project Preview"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            
            <!-- Iris Reveal Layer -->
            <div class="iris-layer z-10 bg-white/95 p-8 flex flex-col justify-between text-[#1C1C1C]">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-[#3186FF] uppercase font-bold tracking-widest">Case 01 // Agency Lead</span>
                <span class="text-xs font-mono text-slate-500">WordPress / Elementor</span>
              </div>
              <div>
                <h3 class="font-anton text-4xl sm:text-5xl text-[#1C1C1C] uppercase mb-3">DESO</h3>
                <p class="font-mono text-xs sm:text-sm text-slate-600 max-w-lg leading-relaxed">
                  Working in a simulated agency where I spearheaded the team to overhaul the client's website architecture and visual identity.
                </p>
              </div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-500 pt-4 border-t border-black/[0.08]">
                <span>VIEW LIVE DEPLOYMENT</span>
                <span class="text-[#3186FF] font-bold">↗</span>
              </div>
            </div>

            <!-- Mobile Default Text Overlay -->
            <div class="lg:hidden absolute inset-0 z-20 flex flex-col justify-end p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
              <h3 class="font-anton text-3xl text-white uppercase">DESO</h3>
              <p class="font-mono text-xs text-white/80">WordPress / Visual Identity</p>
            </div>
          </a>

          <!-- Card 2: FREEZER-PAL (5 cols) -->
          <a
            href="https://sem3e.fekdesign.dk"
            target="_blank"
            rel="noopener noreferrer"
            class="project-card col-span-1 lg:col-span-5 h-[384px] p-8 flex flex-col justify-between group bg-white/85 reveal-on-scroll reveal-delay-1"
          >
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">Latest Exam</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-[#3186FF]/15 text-[#3186FF] border border-[#3186FF]/30 font-semibold">
                TOP GRADE
              </span>
            </div>

            <div>
              <h3 class="font-anton text-4xl sm:text-5xl text-[#1C1C1C] uppercase mb-3 group-hover:text-[#3186FF] transition-colors">
                FREEZER-PAL
              </h3>
              <div class="w-16 h-[2px] bg-[#3186FF] mb-4"></div>
              <p class="font-mono text-xs sm:text-sm text-slate-600 leading-relaxed">
                Third semester exam project: end-to-end visual identity and responsive web application showcase.
              </p>
            </div>

            <div class="flex items-center justify-between text-xs font-mono text-slate-500 pt-4 border-t border-black/[0.08]">
              <span>EXPLORE DEPLOYMENT</span>
              <span class="text-[#3186FF] font-bold">↗</span>
            </div>
          </a>

          <!-- Card 3: Video Game Website (5 cols) -->
          <a
            href="https://sotf.fekdesign.dk/"
            target="_blank"
            rel="noopener noreferrer"
            class="project-card col-span-1 lg:col-span-5 h-[384px] group reveal-on-scroll reveal-delay-2"
          >
            <div class="absolute inset-0 z-0">
              <img
                src="/sotf.webp"
                alt="Video Game Project"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>

            <!-- Iris Reveal Layer -->
            <div class="iris-layer z-10 bg-white/95 p-8 flex flex-col justify-between text-[#1C1C1C]">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-[#3186FF] uppercase font-bold tracking-widest">Case 03 // Interactive</span>
                <span class="text-xs font-mono text-slate-500">HTML / CSS</span>
              </div>
              <div>
                <h3 class="font-anton text-4xl text-[#1C1C1C] uppercase mb-2">Video Game</h3>
                <p class="font-mono text-xs text-slate-600 leading-relaxed">
                  First semester independent project creating a custom interactive gaming web portal with custom CSS styling.
                </p>
              </div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-500 pt-4 border-t border-black/[0.08]">
                <span>VIEW PROJECT</span>
                <span class="text-[#3186FF] font-bold">↗</span>
              </div>
            </div>

            <div class="lg:hidden absolute inset-0 z-20 flex flex-col justify-end p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
              <h3 class="font-anton text-3xl text-white uppercase">Video Game</h3>
              <p class="font-mono text-xs text-white/80">Custom Web Experience</p>
            </div>
          </a>

          <!-- Card 4: Timelogger (7 cols) -->
          <a
            href="https://github.com/fek-design/web-logbook"
            target="_blank"
            rel="noopener noreferrer"
            class="project-card col-span-1 lg:col-span-7 h-[384px] p-8 flex flex-col justify-between group bg-white/85 reveal-on-scroll reveal-delay-3"
          >
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">Internal Tooling</span>
              <span class="text-xs font-mono text-slate-400">React / Tailwind</span>
            </div>

            <div>
              <h3 class="font-anton text-4xl sm:text-5xl text-[#1C1C1C] uppercase mb-3 group-hover:text-[#3186FF] transition-colors">
                TIMELOGGER
              </h3>
              <p class="font-mono text-xs sm:text-sm text-slate-600 max-w-lg leading-relaxed">
                Agency productivity web app designed to log and manage team hours with a dedicated analytics dashboard and registration flow.
              </p>
            </div>

            <div class="flex items-center justify-between text-xs font-mono text-slate-500 pt-4 border-t border-black/[0.08]">
              <span>VIEW REPOSITORY</span>
              <span class="text-[#3186FF] font-bold">↗</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Section 03: The Synthesis (Journal) -->
    <section id="logs" class="py-24 md:py-32 border-b border-black/[0.08] bg-[#F8FAFC]">
      <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-24">
        <div class="space-y-2 reveal-on-scroll">
          <div class="flex items-center gap-2">
            <ChromeSparkle size={18} />
            <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">03 // JOURNAL & PRINCIPLES</span>
          </div>
          <h2 class="section-title mb-0">THE SYNTHESIS</h2>
          <p class="font-mono text-xs sm:text-sm uppercase text-slate-600">
            // Beyond The Terminal
          </p>
        </div>

        <!-- 01: Technology -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center reveal-on-scroll">
          <div class="lg:col-span-5 h-[320px] rounded-3xl overflow-hidden glass-panel p-2">
            <img
              src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2000&auto=format&fit=crop"
              class="w-full h-full object-cover rounded-2xl"
              alt="Technology Sandbox"
            />
          </div>
          <div class="lg:col-span-7 glass-panel p-8 sm:p-12 rounded-3xl space-y-4">
            <span class="font-mono text-xs text-[#3186FF] uppercase font-bold tracking-widest">01 / Sandbox</span>
            <h3 class="font-anton text-3xl sm:text-4xl text-[#1C1C1C] uppercase">Technology</h3>
            <p class="font-mono text-xs sm:text-sm leading-relaxed text-slate-600">
              I don't believe in using the same solution for everything. I test new technologies and frameworks by building real systems with them, pushing boundaries rather than adhering to rigid formulas.
            </p>
          </div>
        </div>

        <!-- 02: Photography -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center reveal-on-scroll">
          <div class="lg:col-span-7 lg:order-1 order-2 glass-panel p-8 sm:p-12 rounded-3xl space-y-4">
            <span class="font-mono text-xs text-[#3186FF] uppercase font-bold tracking-widest">02 / Lens</span>
            <h3 class="font-anton text-3xl sm:text-4xl text-[#1C1C1C] uppercase">Photography</h3>
            <p class="font-mono text-xs sm:text-sm leading-relaxed text-slate-600">
              Documenting the overlooked. From the rigid geometry of architectural spaces to the fluid reality of street photography, capturing both calculated compositions and the quiet, authentic memories of everyday life.
            </p>
          </div>
          <div class="lg:col-span-5 lg:order-2 order-1 h-[320px] rounded-3xl overflow-hidden glass-panel p-2">
            <img
              src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?q=80&w=1000&auto=format&fit=crop"
              class="w-full h-full object-cover rounded-2xl"
              alt="Photography Lens"
            />
          </div>
        </div>

        <!-- 03: The Gym -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center reveal-on-scroll">
          <div class="lg:col-span-5 h-[320px] rounded-3xl overflow-hidden glass-panel p-2">
            <img
              src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1000&auto=format&fit=crop"
              class="w-full h-full object-cover rounded-2xl"
              alt="The Gym"
            />
          </div>
          <div class="lg:col-span-7 glass-panel p-8 sm:p-12 rounded-3xl space-y-4">
            <span class="font-mono text-xs text-[#3186FF] uppercase font-bold tracking-widest">03 / Iron</span>
            <h3 class="font-anton text-3xl sm:text-4xl text-[#1C1C1C] uppercase">The Gym</h3>
            <p class="font-mono text-xs sm:text-sm leading-relaxed text-slate-600">
              I believe in discipline over motivation. Pushing physical thresholds burns away cognitive noise, generating the mental clarity required to execute complex design work and solve structural problems without waiting for inspiration.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 04: Contact (Say Hello) -->
    <section id="contact" class="py-28 md:py-36 bg-[#F8FAFC]">
      <div class="max-w-4xl mx-auto px-6 md:px-12 text-center space-y-8 reveal-on-scroll">
        <div class="flex items-center justify-center gap-2">
          <HudBadge text="STATUS: ACCEPTING COMMISSIONS" statusDot={true} statusColor="#3186FF" />
        </div>

        <h2 class="font-anton text-[#1C1C1C] uppercase leading-none tracking-tight text-5xl sm:text-7xl lg:text-8xl">
          SAY HELLO
        </h2>

        <p class="font-mono text-sm sm:text-base text-slate-600 max-w-lg mx-auto leading-relaxed">
          Currently open for new collaborations, creative development, and experience architecture. Let's build something exceptional together.
        </p>

        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <PillButton href="mailto:fkoesgaard@gmail.com" variant="primary" size="lg">
            Send an Email →
          </PillButton>
          <PillButton href="https://github.com/fek-design" variant="secondary" size="lg">
            GitHub
          </PillButton>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 border-t border-black/[0.08] bg-[#F8FAFC] text-xs font-mono text-slate-500">
      <div class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col sm:flex-row justify-between items-center gap-6">
        <p>© 2026 FEKDESIGN. All rights reserved.</p>
        <div class="flex gap-8 font-semibold">
          <a href="https://github.com/fek-design" class="hover:text-[#1C1C1C] transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/felix-koesgaard/" class="hover:text-[#1C1C1C] transition-colors">LinkedIn</a>
          <a href="https://www.facebook.com/FelixKoesgaard/" class="hover:text-[#1C1C1C] transition-colors">Facebook</a>
        </div>
      </div>
    </footer>
  </main>

  <!-- Client-side Motion Choreography (Physics-Weighted Motion & Scroll Observer) -->
  <script>
    import { animate } from 'motion';

    // 1. Boot Launch Sequence (Heavy Physical Easing & Settle)
    async function initSequence() {
      const progressBar = document.getElementById('boot-progress');
      const bootLog = document.getElementById('boot-log');
      const bootSequence = document.getElementById('boot-sequence');
      const heroModel = document.getElementById('hero-model');

      if (progressBar && bootSequence) {
        // Deliberate physical acceleration and deceleration
        await animate(progressBar, { width: '100%' }, { duration: 1.6, ease: [0.16, 1, 0.3, 1] }).finished;
        if (bootLog) bootLog.innerText = 'Canvas ready.';

        await new Promise((r) => setTimeout(r, 180));
        await animate(bootSequence, { opacity: 0, y: -48 }, { duration: 0.8, ease: [0.16, 1, 0.3, 1] }).finished;
        bootSequence.style.display = 'none';

        if (heroModel) {
          // Weighted physical reveal
          animate(heroModel, { clipPath: ['inset(100% 0 0 0)', 'inset(0% 0 0 0)'] }, { duration: 1.4, ease: [0.16, 1, 0.3, 1] });
        }
      }
    }

    // 2. Scroll-Reactive Navigation (Transparent on Hero, Frosted on Scroll)
    function initNavbarScroll() {
      const navbar = document.getElementById('navbar');
      if (!navbar) return;

      const handleScroll = () => {
        if (window.scrollY > 60) {
          navbar.classList.add('nav-scrolled');
          navbar.classList.remove('nav-transparent');
        } else {
          navbar.classList.add('nav-transparent');
          navbar.classList.remove('nav-scrolled');
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // 3. Scroll-Driven Gravitational Ease-Up Reveal
    function initScrollReveals() {
      const revealItems = document.querySelectorAll('.reveal-on-scroll');
      if (!revealItems.length) return;

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -48px 0px'
      });

      revealItems.forEach((item) => observer.observe(item));
    }

    function initAll() {
      initSequence();
      initNavbarScroll();
      initScrollReveals();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</Layout>
