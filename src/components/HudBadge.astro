---
interface Props {
  text: string;
  statusDot?: boolean;
  statusColor?: string;
  class?: string;
}

const {
  text,
  statusDot = false,
  statusColor = '#3186FF',
  class: className = '',
} = Astro.props;
---

<div class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-black/[0.08] bg-white/85 backdrop-blur-md text-[11px] font-mono uppercase tracking-wider text-[#1C1C1C] shadow-sm ${className}`}>
  {statusDot && (
    <span
      class="w-2 h-2 rounded-full"
      style={`background-color: ${statusColor};`}
    ></span>
  )}
  <span>{text}</span>
</div>
