---
interface Props {
  size?: number;
  class?: string;
}

const {
  size = 24,
  class: className = '',
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`inline-block chrome-sparkle ${className}`}
  aria-hidden="true"
>
  <defs>
    <!-- Strictly blue spectrum gradient: Pure white highlight through pure #3186FF and royal blue -->
    <linearGradient id="chromeBlueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="35%" stop-color="#93C5FD" />
      <stop offset="70%" stop-color="#3186FF" />
      <stop offset="100%" stop-color="#1E40AF" />
    </linearGradient>
  </defs>
  <!-- 4-point Gemini Star / Avant-Garde Sparkle -->
  <path
    d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z"
    fill="url(#chromeBlueGrad)"
  />
</svg>
