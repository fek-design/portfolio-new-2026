---
interface Props {
  size?: number;
  class?: string;
  glow?: boolean;
}

const {
  size = 24,
  class: className = '',
  glow = true,
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`inline-block ${glow ? 'chrome-sparkle' : ''} ${className}`}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="chromeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="40%" stop-color="#93C5FD" />
      <stop offset="70%" stop-color="#3186FF" />
      <stop offset="100%" stop-color="#C084FC" />
    </linearGradient>
    <filter id="sparkleBlur" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <!-- 4-point Gemini / Chrome Sparkle -->
  <path
    d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z"
    fill="url(#chromeGrad)"
    filter="url(#sparkleBlur)"
  />
</svg>
